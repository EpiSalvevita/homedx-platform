# Copy to .env on the NAS before starting the stack:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=homedx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homedx

# --- Published ports on the NAS (LAN) ---
BACKEND_PORT=4000
WEB_PORT=8080
# Optional HTTPS (requires nginx-tls.conf + certs in ./certs/)
# WEB_TLS_PORT=8443

# --- Backend (required in production) ---
JWT_SECRET=change-me-long-random-string
NODE_ENV=production
# Browser origins allowed to call the API directly (port 4000/4002).
# Web behind nginx same-origin proxy does not need these; keep the IP + hostnames anyway.
CORS_ORIGINS=http://192.168.1.50:8080,http://salvenas.fritz.box:8080,http://homedx.de:8080

APP_URL=http://192.168.1.50:4000
# Public web URL used in verification / password-reset emails (required for working mail links)
# WEB_APP_URL=http://homedx.de:8080

# Transactional email (SMTP). Without these, customers will not receive signup/reset mails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="homeDX <noreply@homedx.de>"

# Optional: video calls (Daily.co)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional: payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox

# Demo doctors: off by default (set true only for first-time demo seed)
HOMEDX_SEED_DOCTORS=false
# SEED_DOCTOR_PASSWORD=only-if-seeding-manually
