# Copy to .env on the NAS before starting the stack:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=homedx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homedx

# --- Published ports on the NAS (LAN) ---
BACKEND_PORT=4000
WEB_PORT=8080

# --- Backend ---
JWT_SECRET=change-me-long-random-string
APP_URL=http://192.168.1.50:4000

# CORS: comma-separated LAN origins for web + mobile (adjust IP/host)
# CORS_ORIGINS=http://192.168.1.50:8080,http://192.168.1.50:4000

# Optional: video calls (Daily.co)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional: payments (not required for internal review)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Seed demo doctors on container start (set false after first boot)
HOMEDX_SEED_DOCTORS=true
