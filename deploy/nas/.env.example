# Copy to .env on the NAS before starting the stack:
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=homedx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=homedx

# --- Published ports on the NAS (LAN) ---
BACKEND_PORT=4000
WEB_PORT=8080
# Optional HTTPS (requires nginx-tls.conf + certs in ./certs/)
# WEB_TLS_PORT=8443

# --- Backend (required in production) ---
JWT_SECRET=change-me-long-random-string
NODE_ENV=production
CORS_ORIGINS=http://192.168.1.50:8080

APP_URL=http://192.168.1.50:4000

# Optional: video calls (Daily.co)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional: payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox

# Demo doctors: off by default (set true only for first-time demo seed)
HOMEDX_SEED_DOCTORS=false
# SEED_DOCTOR_PASSWORD=only-if-seeding-manually
