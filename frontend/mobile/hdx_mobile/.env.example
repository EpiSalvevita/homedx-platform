# API Configuration (development)
# Physical phone + backend in WSL2: http://<Windows Wi-Fi/Ethernet IPv4>:4000 (ipconfig on Windows — not WSL).
# Requires Windows port forwarding: setup-wsl-port-forward.cmd as Admin (see docs/WSL2_PORT_FORWARDING.md).
# Android emulator on Windows: http://10.0.2.2:4000
# USB debugging: adb reverse tcp:4000 tcp:4000 then http://127.0.0.1:4000
# Refresh URL after DHCP changes: .\check-homedx-connectivity.ps1 -UpdateMobileEnv (Windows, repo root)
API_BASE_URL=http://localhost:4000
# Production: API_BASE_URL=https://api.homedx.com

# Environment
ENV=development
