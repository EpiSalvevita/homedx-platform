# Copy to .env and adjust for local development:
#   cp .env.example .env

# Required
JWT_SECRET=change-me-long-random-string

# Database (Prisma)
DATABASE_URL=postgresql://homedx:change-me@localhost:5432/homedx

# Server
PORT=4000
NODE_ENV=development

# CORS: comma-separated allowed origins (omit for dev = allow all)
# CORS_ORIGINS=http://localhost:8080,http://192.168.1.50:8080

# App URL (used in links / callbacks)
APP_URL=http://localhost:4000

# Optional: video calls (Daily.co)
# DAILY_API_KEY=
# DAILY_DOMAIN=

# Optional: payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MODE=sandbox

# Optional: demo doctor seed (npm run seed:doctors)
# HOMEDX_SEED_DOCTORS=false
# SEED_DOCTOR_PASSWORD=
